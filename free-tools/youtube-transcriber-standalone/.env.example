# YouTube Transcriber Configuration
# Copy this file to .env and fill in your values

# === Required Configuration ===

# OpenAI API Key (required for Whisper transcription)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# === Optional Configuration ===

# Audio Processing Settings
CHUNK_SIZE_SECONDS=300           # Audio chunk size in seconds (default: 300 = 5 minutes)
CHUNK_OVERLAP_SECONDS=10         # Overlap between chunks (default: 10)
MAX_FILE_SIZE_MB=500             # Maximum download file size (default: 500)
AUDIO_FORMAT=mp3                 # Audio format: mp3, wav, etc. (default: mp3)
SAMPLE_RATE=16000                # Audio sample rate (default: 16000)

# Directory Paths
AUDIO_CHUNKS_DIR=audio_chunks    # Temp directory for audio chunks
TRANSCRIPTS_DIR=transcripts      # Output directory for transcripts
TEMP_DOWNLOAD_DIR=temp_downloads # Temp directory for downloads

# OpenAI Configuration
OPENAI_MODEL=whisper-1           # Whisper model (default: whisper-1)
OPENAI_MAX_RETRIES=3             # Max API retries (default: 3)
OPENAI_TIMEOUT=300               # API timeout in seconds (default: 300)

# Processing Configuration
MAX_CONCURRENT_CHUNKS=5          # Max parallel chunk processing (default: 5)
CLEANUP_TEMP_FILES=true          # Clean up temp files after processing (default: true)

# Logging Configuration
LOG_LEVEL=INFO                   # Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_TO_FILE=false                # Enable file logging (default: false)
LOG_FILE_PATH=logs/app.log       # Log file path (default: logs/app.log)

# Request Configuration
DOWNLOAD_TIMEOUT=600             # YouTube download timeout in seconds (default: 600)
